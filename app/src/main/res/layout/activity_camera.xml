<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/view_finder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fillCenter" />

    <!-- Face guide oval overlay -->
    <View
        android:layout_width="240dp"
        android:layout_height="320dp"
        android:background="@drawable/oval_guide"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/capture_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp" />

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="@drawable/circle_button_bg"
            android:contentDescription="返回" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="将脸部对准椭圆框"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:gravity="center" />

        <View android:layout_width="40dp" android:layout_height="40dp" />
    </LinearLayout>

    <!-- Bottom capture bar -->
    <LinearLayout
        android:id="@+id/capture_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingBottom="48dp"
        android:paddingTop="24dp"
        android:background="#80000000"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="请保持面部光线均匀，靠近自然光源效果更佳"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp"
            android:layout_marginBottom="20dp" />

        <!-- Capture button -->
        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="80dp">

            <View
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/capture_button_ring" />

            <ImageButton
                android:id="@+id/btn_capture"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:background="@drawable/capture_button_inner"
                android:src="@android:drawable/ic_menu_camera"
                android:contentDescription="拍照" />

            <ProgressBar
                android:id="@+id/progress_capture"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:visibility="gone"
                android:indeterminateTint="@color/accent_pink" />
        </FrameLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
